<?xml version="1.0" encoding="utf-8"?>
<!--
    摇杆 · 历史位置浮窗：与地图浮窗同为 340dp × 560dp、28dp 圆角卡片。
    保留 JoyStick.java 依赖的 FrameLayout 根布局与全部 id
    （joystick_his_tips / joystick_his_searchView / joystick_his_close /
    joystick_his_record_no_textview / joystick_his_record_list_view）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="560dp"
    android:background="@drawable/bg_joystick_panel"
    android:elevation="2dp"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部标题 + 关闭 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/joystick_his_tips"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/joystick_history_tips"
                android:textAppearance="@style/TextAppearance.App.Section"
                android:textColor="@color/on_surface" />

            <ImageButton
                android:id="@+id/joystick_his_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_joystick_button"
                android:contentDescription="@string/common_close"
                android:src="@drawable/ic_close"
                android:tint="@color/on_surface_variant" />
        </LinearLayout>

        <!-- 搜索框 -->
        <SearchView
            android:id="@+id/joystick_his_searchView"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_segmented"
            android:iconifiedByDefault="true"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:queryHint="@string/app_search_tips" />

        <!-- 历史记录列表 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/joystick_his_record_no_textview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/history_idle"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/text_body" />

            <ListView
                android:id="@+id/joystick_his_record_list_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="12dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
