<?xml version="1.0" encoding="utf-8"?>
<!--
    按键式摇杆：3×3 网格，方向键 44dp 触控，中心 56dp 圆形 primary。
    方向图标全部使用 Material Symbols Rounded（ic_north / ic_south_west 等）。
    Java 依赖 id：btn_north / btn_south / btn_west / btn_east / btn_north_east /
    btn_south_east / btn_north_west / btn_south_west / btn_center。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- 第一行 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_north_west"
            android:layout_width="@dimen/joystick_btn_width"
            android:layout_height="@dimen/joystick_btn_height"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_north_west"
            android:tint="@color/on_surface_variant"
            tools:ignore="TouchTargetSizeCheck" />

        <ImageButton
            android:id="@+id/btn_north"
            android:layout_width="@dimen/joystick_btn_width"
            android:layout_height="@dimen/joystick_btn_height"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_north"
            android:tint="@color/on_surface_variant"
            tools:ignore="TouchTargetSizeCheck" />

        <ImageButton
            android:id="@+id/btn_north_east"
            android:layout_width="@dimen/joystick_btn_width"
            android:layout_height="@dimen/joystick_btn_height"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_north_east"
            android:tint="@color/on_surface_variant"
            tools:ignore="TouchTargetSizeCheck" />
    </LinearLayout>

    <!-- 第二行：中心按钮更大，形成视觉焦点 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_west"
            android:layout_width="@dimen/joystick_btn_width"
            android:layout_height="@dimen/joystick_btn_height"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_west"
            android:tint="@color/on_surface_variant"
            tools:ignore="TouchTargetSizeCheck" />

        <ImageButton
            android:id="@+id/btn_center"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_route_start"
            android:contentDescription="@string/joystick_move"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_play"
            android:tint="@color/on_primary" />

        <ImageButton
            android:id="@+id/btn_east"
            android:layout_width="@dimen/joystick_btn_width"
            android:layout_height="@dimen/joystick_btn_height"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_east"
            android:tint="@color/on_surface_variant"
            tools:ignore="TouchTargetSizeCheck" />
    </LinearLayout>

    <!-- 第三行 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_south_west"
            android:layout_width="@dimen/joystick_btn_width"
            android:layout_height="@dimen/joystick_btn_height"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_south_west"
            android:tint="@color/on_surface_variant"
            tools:ignore="TouchTargetSizeCheck" />

        <ImageButton
            android:id="@+id/btn_south"
            android:layout_width="@dimen/joystick_btn_width"
            android:layout_height="@dimen/joystick_btn_height"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_south"
            android:tint="@color/on_surface_variant"
            tools:ignore="TouchTargetSizeCheck" />

        <ImageButton
            android:id="@+id/btn_south_east"
            android:layout_width="@dimen/joystick_btn_width"
            android:layout_height="@dimen/joystick_btn_height"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_south_east"
            android:tint="@color/on_surface_variant"
            tools:ignore="TouchTargetSizeCheck" />
    </LinearLayout>

</LinearLayout>
