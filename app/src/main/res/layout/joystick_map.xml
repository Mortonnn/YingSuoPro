<?xml version="1.0" encoding="utf-8"?>
<!--
    摇杆 · 地图选点浮窗：340dp × 560dp、28dp 圆角卡片。
    保留 JoyStick.java 依赖的 FrameLayout 根布局与全部 id
    （joystick_map_tips / joystick_map_searchView / map_search_linear /
    map_search_list_view / map_joystick / map_close / btnGo / btnBack）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="560dp"
    android:background="@drawable/bg_joystick_panel"
    android:elevation="2dp"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部标题 + 关闭 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/joystick_map_tips"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/joystick_map_tips"
                android:textAppearance="@style/TextAppearance.App.Section"
                android:textColor="@color/on_surface" />

            <ImageButton
                android:id="@+id/map_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_joystick_button"
                android:contentDescription="@string/common_close"
                android:src="@drawable/ic_close"
                android:tint="@color/on_surface_variant" />
        </LinearLayout>

        <!-- 搜索框 -->
        <SearchView
            android:id="@+id/joystick_map_searchView"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_segmented"
            android:iconifiedByDefault="true"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:queryHint="@string/app_search_tips" />

        <!-- 地图区 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_panel">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.baidu.mapapi.map.MapView
                    android:id="@+id/map_joystick"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- 搜索结果浮层 -->
                <LinearLayout
                    android:id="@+id/map_search_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_search_panel"
                    android:contentDescription="@string/overlay_search_results"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="6dp"
                    android:visibility="gone">

                    <ListView
                        android:id="@+id/map_search_list_view"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:divider="@android:color/transparent"
                        android:dividerHeight="0dp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_action_circle"
                    android:contentDescription="@string/cur_position"
                    android:src="@drawable/ic_my_location"
                    android:tint="?attr/colorPrimary" />

                <ImageButton
                    android:id="@+id/btnGo"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="@string/joystick_confirm_position"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_position"
                    android:tint="?attr/colorPrimary" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
