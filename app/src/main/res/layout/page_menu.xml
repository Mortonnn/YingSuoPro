<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/menu_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="92dp"
            android:paddingEnd="16dp"
            android:paddingBottom="112dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:text="常用"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="?attr/colorPrimary" />

            <LinearLayout
                android:id="@+id/menu_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="关于"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="?attr/colorPrimary" />

            <LinearLayout
                android:id="@+id/menu_about_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/menu_top_card"
        style="@style/Widget.App.Card.Floating"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:layout_gravity="top"
        android:layout_marginStart="@dimen/top_bar_margin"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/top_bar_margin"
        app:cardCornerRadius="@dimen/radius_xl"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            style="@style/Widget.App.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="4dp"
            app:title="@string/app_name"
            app:titleTextAppearance="@style/TextAppearance.App.Toolbar.Title" />
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
