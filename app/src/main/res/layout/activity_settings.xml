<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.App.Card.Floating"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        app:cardCornerRadius="@dimen/radius_xl"
        app:cardElevation="2dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.App.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:theme="@style/ThemeOverlay.App.Toolbar"
            app:navigationContentDescription="@string/common_back"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:subtitle="@string/pages_settings_subtitle"
            app:subtitleTextAppearance="@style/TextAppearance.App.Toolbar.Subtitle"
            app:title="@string/app_settings"
            app:titleTextAppearance="@style/TextAppearance.App.Toolbar.Title" />
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="16dp" />
</LinearLayout>
