<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    tools:showIn="@layout/main_content">

    <com.baidu.mapapi.map.MapView
        android:id="@+id/bdMapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />

    <!-- 一级模式：位置模拟 / 路线模拟 -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/modeTabGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="92dp"
        android:background="@drawable/bg_segmented"
        android:elevation="2dp"
        android:padding="4dp"
        app:checkedButton="@id/tabPosition"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabPosition"
            style="@style/Widget.App.SegmentButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:text="@string/tab_position_mock"
            app:icon="@drawable/ic_my_location" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabRoute"
            style="@style/Widget.App.SegmentButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:text="@string/tab_route_mock"
            app:icon="@drawable/ic_route" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- 地图右侧浮起圆形按钮 -->
    <LinearLayout
        android:id="@+id/map_control_stack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="92dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/input_pos"
            style="@style/Widget.App.MapButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/input_button"
            app:icon="@drawable/ic_edit_location" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cur_position"
            style="@style/Widget.App.MapButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/cur_position"
            app:icon="@drawable/ic_my_location"
            app:iconTint="@color/primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/zoom_in"
            style="@style/Widget.App.MapButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/zoom_in"
            app:icon="@drawable/ic_add" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/zoom_out"
            style="@style/Widget.App.MapButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/zoom_out"
            app:icon="@drawable/ic_remove" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_map_tip"
        android:fontFamily="sans-serif"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:text="@string/app_statement"
        android:textColor="@color/on_surface_variant"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
