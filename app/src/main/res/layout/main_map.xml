<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    tools:showIn="@layout/main_content">

    <com.baidu.mapapi.map.MapView
        android:id="@+id/bdMapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />

    <!-- 地图右侧浮起圆形按钮 -->
    <LinearLayout
        android:id="@+id/map_control_stack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="92dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saved_positions"
            style="@style/Widget.App.MapButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/saved_locations"
            app:icon="@drawable/ic_bookmark" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_current"
            style="@style/Widget.App.MapButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/overlay_poi_save"
            app:icon="@drawable/ic_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/input_pos"
            style="@style/Widget.App.MapButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/input_button"
            app:icon="@drawable/ic_edit_location" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cur_position"
            style="@style/Widget.App.MapButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/cur_position"
            app:icon="@drawable/ic_my_location"
            app:iconTint="?attr/colorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/zoom_in"
            style="@style/Widget.App.MapButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/zoom_in"
            app:icon="@drawable/ic_add" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/zoom_out"
            style="@style/Widget.App.MapButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/zoom_out"
            app:icon="@drawable/ic_remove" />
    </LinearLayout>

    <TextView
        android:id="@+id/app_statement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="86dp"
        android:background="@drawable/bg_map_tip"
        android:fontFamily="sans-serif"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:text="@string/app_statement"
        android:textColor="@color/on_surface_variant"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
