<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    app:iconSpaceReserved="true">

    <PreferenceCategory
        app:title="@string/setting_group_map"
        app:iconSpaceReserved="true">
        <ListPreference
            app:key="setting_map_style"
            app:title="@string/setting_map_style"
            app:entries="@array/array_map_style"
            app:entryValues="@array/array_map_style_values"
            app:dialogTitle="@string/setting_map_style"
            app:defaultValue="normal"
            app:useSimpleSummaryProvider="true"
            app:icon="@drawable/ic_map"
            app:iconSpaceReserved="true" />
    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/setting_group_move"
        app:iconSpaceReserved="true">
        <ListPreference
            app:key="setting_joystick_type"
            app:title="@string/setting_joystick_type"
            app:entries="@array/array_joystick_type"
            app:entryValues="@array/array_joystick_type_values"
            app:dialogTitle="@string/setting_joystick_type"
            app:defaultValue="0"
            app:icon="@drawable/ic_gamepad"
            app:iconSpaceReserved="true">
        </ListPreference>

        <EditTextPreference
            app:key="setting_walk"
            app:title="@string/setting_walk"
            app:defaultValue="@string/setting_walk_default"
            app:summary="@string/setting_walk_default"
            app:icon="@drawable/ic_directions_walk"
            app:iconSpaceReserved="true"/>

        <EditTextPreference
            app:key="setting_run"
            app:title="@string/setting_run"
            app:defaultValue="@string/setting_run_default"
            app:summary="@string/setting_run_default"
            app:icon="@drawable/ic_directions_run"
            app:iconSpaceReserved="true"/>

        <EditTextPreference
            app:key="setting_bike"
            app:title="@string/setting_bike"
            app:defaultValue="@string/setting_bike_default"
            app:summary="@string/setting_bike_default"
            app:icon="@drawable/ic_directions_bike"
            app:iconSpaceReserved="true"/>

        <EditTextPreference
            app:key="setting_altitude"
            app:title="@string/setting_altitude"
            app:defaultValue="@string/setting_altitude_default"
            app:summary="@string/setting_altitude_default"
            app:icon="@drawable/ic_terrain"
            app:iconSpaceReserved="true"/>

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/setting_group_route"
        app:iconSpaceReserved="true">

        <EditTextPreference
            app:key="setting_route_speed"
            app:title="@string/route_setting_speed"
            app:defaultValue="@string/route_speed_default"
            app:summary="@string/route_speed_default"
            app:icon="@drawable/ic_speed"
            app:iconSpaceReserved="true"/>

        <EditTextPreference
            app:key="setting_route_speed_float"
            app:title="@string/route_setting_speed_float"
            app:defaultValue="@string/route_speed_float_default"
            app:summary="@string/route_speed_float_default"
            app:icon="@drawable/ic_percent"
            app:iconSpaceReserved="true"/>

        <EditTextPreference
            app:key="setting_route_interval"
            app:title="@string/route_setting_interval"
            app:defaultValue="@string/route_interval_default"
            app:summary="@string/route_interval_default"
            app:icon="@drawable/ic_timer"
            app:iconSpaceReserved="true"/>

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/setting_group_location_offset"
        app:iconSpaceReserved="true">

        <SwitchPreferenceCompat
            app:key="setting_random_offset"
            app:title="@string/setting_random_offset"
            app:summary="@string/setting_random_offset_summary"
            app:defaultValue="false"
            app:icon="@drawable/ic_shuffle"
            app:iconSpaceReserved="true"/>
        <EditTextPreference
            app:key="setting_lat_max_offset"
            app:title="@string/setting_lat_max_offset"
            app:defaultValue="@string/setting_random_offset_default"
            app:summary="@string/setting_random_offset_default"
            app:icon="@drawable/ic_straighten"
            app:iconSpaceReserved="true"/>
        <EditTextPreference
            app:key="setting_lon_max_offset"
            app:title="@string/setting_lon_max_offset"
            app:defaultValue="@string/setting_random_offset_default"
            app:summary="@string/setting_random_offset_default"
            app:icon="@drawable/ic_repeat"
            app:iconSpaceReserved="true"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/setting_group_log"
        app:iconSpaceReserved="true">

        <SwitchPreferenceCompat
            app:key="setting_log_off"
            app:title="@string/setting_log_off"
            app:defaultValue="false"
            app:icon="@drawable/ic_terminal"
            app:iconSpaceReserved="true"/>
        <EditTextPreference
            app:key="setting_history_expiration"
            app:title="@string/setting_history_expiration"
            app:defaultValue="@string/history_expiration"
            app:summary="@string/history_expiration"
            app:icon="@drawable/ic_history"
            app:iconSpaceReserved="true"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/setting_group_about"
        app:iconSpaceReserved="true">

        <Preference
            app:key="setting_version"
            app:title="@string/setting_version"
            app:icon="@drawable/ic_info"
            app:iconSpaceReserved="true"/>

        <Preference
            app:key="setting_author"
            app:title="@string/setting_author"
            app:defaultValue="@string/app_author"
            app:summary="@string/app_author"
            app:icon="@drawable/ic_person"
            app:iconSpaceReserved="true"/>
    </PreferenceCategory>
</PreferenceScreen>
